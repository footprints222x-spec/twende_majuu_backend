# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Flask ---------------------------------------------------------------
FLASK_APP=wsgi.py
# development | production  (testing is only used by the test suite)
APP_ENV=development

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# --- Database (PostgreSQL) -----------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://twende:Aquila123@localhost:5432/twende_majuu


# --- Cloudinary (https://console.cloudinary.com -> Settings -> API Keys) --
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level folder for all uploads inside your Cloudinary media library
CLOUDINARY_FOLDER=twende-majuu

# --- CORS: comma separated list of origins allowed to call the API --------
# Vite's default is 5173, Create React App's is 3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Optional tuning (defaults shown) --------------------------------------
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=7
# MAX_IMAGE_SIZE_MB=5
# MAX_DOCUMENT_SIZE_MB=10
# MAX_DOCUMENTS_PER_APPLICANT=25
